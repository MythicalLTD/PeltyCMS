{
  "id": "gateway-netopia",
  "name": "Netopia Payments",
  "version": "0.1.0",
  "kind": "gateway",
  "engine": "wasm",
  "provides": "netopia",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.gateway.netopia",
  "author": "MythicalSystems",
  "permissions": ["payments.process", "network.outbound"],
  "capabilities": {
    "http": ["secure.mobilpay.ro", "secure.sandbox.netopia-payments.ro", "$setting:api_base"],
    "secrets": ["signature_key", "pos_signature"]
  },
  "settings": [
    { "key": "live", "label": "addons.gateway.setting.live", "kind": "bool", "required": false, "default": false },
    { "key": "api_base", "label": "addons.gateway.setting.api_base", "kind": "text", "required": false }
  ]
}
