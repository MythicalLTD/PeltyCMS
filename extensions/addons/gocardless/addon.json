{
  "id": "gateway-gocardless",
  "name": "GoCardless",
  "version": "0.1.0",
  "kind": "gateway",
  "engine": "wasm",
  "provides": "gocardless",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.gateway.gocardless",
  "author": "MythicalSystems",
  "permissions": [
    "payments.process",
    "network.outbound"
  ],
  "capabilities": {
    "http": [
      "api.gocardless.com",
      "api-sandbox.gocardless.com",
      "$setting:api_base"
    ],
    "secrets": [
      "access_token",
      "webhook_secret"
    ]
  },
  "settings": []
}
