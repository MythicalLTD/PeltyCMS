{
  "name": "@peltycms/addon-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed, dependency-free SDK for addon UI frames (sandboxed iframes) talking to the PeltyCMS host over the postMessage bridge.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm --dir ../../../frontend exec tsc -p \"$PWD\"",
    "test": "pnpm --dir ../../../frontend exec vitest run --root \"$PWD\""
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
