DATABASE_URL=postgres://postgres@127.0.0.1:55432/peltycms
# Default API bind. If the port is taken (e.g. another panel on :8080), change both:
PELTY_BIND=127.0.0.1:8080
PELTY_COOKIE_SECURE=false
# Reverse proxies whose X-Forwarded-For / X-Real-IP / X-Forwarded-Proto are trusted
# (IPs or CIDRs, comma separated), e.g. 127.0.0.1,::1 for nginx/Caddy on this host.
# PELTY_TRUSTED_PROXIES=127.0.0.1,::1
# Offline IP → city/country MMDB for login alerts (DB-IP Lite needs no key).
# Default path if unset: data/geoip/dbip-city-lite.mmdb
# Download: ./scripts/download-geoip.sh
# PELTY_GEOIP_DB=data/geoip/dbip-city-lite.mmdb
# Upload caps in MB (defaults shown; attachments max 50, addon packages max 64).
# A reverse proxy has its own limit too (nginx: client_max_body_size).
# PELTY_UPLOAD_ATTACHMENT_MB=50
# PELTY_UPLOAD_AVATAR_MB=2
# PELTY_UPLOAD_KYC_MB=20
# PELTY_UPLOAD_DOWNLOAD_MB=25
# PELTY_UPLOAD_IMPORT_MB=5
# PELTY_UPLOAD_ADDON_MB=64
# Background jobs. PELTY_SCHEDULER=false: run `pelty-server cron run` every minute
# from system cron instead (per-task run hours: Admin > Automation).
# PELTY_SCHEDULER=true
# PELTY_SCHEDULER_INTERVAL_SECS=60
# PELTY_WORKER_CONCURRENCY=10
# Optional Redis (any version) for several instances: shared rate limits, one
# scheduler leader, and admin changes reloaded on every instance (console
# `cluster` lists them). Unset: single instance, in-memory limits.
# PELTY_REDIS_URL=redis://127.0.0.1:6379/0
RUST_LOG=info,sqlx=warn
# Email (unset PELTY_SMTP_URL = log only)
# PELTY_SMTP_URL=smtps://user:pass@smtp.example.com:465
PELTY_MAIL_FROM=PeltyCMS <no-reply@example.com>
# Browser origin for cookies/links/WebSockets. With `cargo dep` / Vite, use the UI origin
# (e.g. http://127.0.0.1:5173). localhost and 127.0.0.1 are treated as the same loopback site.
PELTY_PUBLIC_URL=http://127.0.0.1:5173
# Secrets at rest (TOTP seeds). Base64 of 32 random bytes: openssl rand -base64 32
# Required to enrol 2FA; no default. Keep it stable: changing it locks out 2FA users.
# PELTY_ENCRYPTION_KEY=
