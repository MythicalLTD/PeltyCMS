   "body": {
    "slug": "store-terms",
    "title": "Store terms",
    "description": "What you get when you buy from the store.",
    "published": true,
    "show_in_nav": false,
    "sort_order": 20,
    "blocks": [
     {
      "type": "text",
      "props": {
       "title": "Store terms",
       "body": "Purchases are virtual items for this Rust server and have no cash value. They are linked to the SteamID you use at checkout.\n\nVIP and queue skips renew every month until you cancel in your account. Kits and crates are delivered once, when you are online. Items are lost on wipe like any other item. If you are banned for breaking the server rules, purchases are not refunded.\n\nThis server is not affiliated with or endorsed by Facepunch Studios.\n\nQuestions? Open a support ticket and we will help."
      }
     }
    ]
   }
  },
  {
   "post": "/api/v1/admin/site/pages",
   "optional": true,
   "body": {
    "slug": "refunds",
    "title": "Refund policy",
    "description": "When and how you can get your money back.",
    "published": true,
    "show_in_nav": false,
    "sort_order": 21,
    "blocks": [
     {
      "type": "text",
      "props": {
       "title": "Refund policy",
       "body": "Store items are digital and are delivered to your Steam account straight after payment, so purchases are final once they have been delivered.\n\nWe refund a purchase in full when it could not be delivered and our team cannot fix the delivery within 72 hours, or when you were charged twice for the same order. Open a support ticket with your order number and we will look at it within two working days.\n\nMonthly packages can be cancelled at any time in your account. You keep the perks until the end of the period you already paid for, and you are not charged again.\n\nIf you open a chargeback or payment dispute instead of contacting us, the items of that order are removed and the account may be blocked from the store."
      }
     }
    ]
   }
  },
  {
   "post": "/api/v1/admin/site/pages",
   "optional": true,
   "body": {
    "slug": "store-privacy",
    "title": "Privacy policy",
    "description": "What data the store keeps and why.",
    "published": true,
    "show_in_nav": false,
    "sort_order": 22,
    "blocks": [
     {
      "type": "text",
      "props": {
       "title": "Privacy policy",
       "body": "To deliver your purchases we store your email address, your Steam account and your order history. Payments are handled by our payment provider; we never see or store your full card details.\n\nWe use this data only to run the store: to deliver items, send receipts, answer support tickets and prevent fraud. We do not sell it or share it with anyone else, except when the law requires it.\n\nOrder records are kept for as long as accounting law requires. You can ask for a copy of your data, or for your account to be deleted, by opening a support ticket.\n\nThe store uses only the cookies it needs to keep you signed in and to remember your basket."
      }
     }
    ]
   }
