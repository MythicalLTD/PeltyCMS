{
 "id": "rust",
 "site_name": "Rust Wasteland",
 "steps": [
  {
   "put": "/api/v1/admin/modules/game_profiles",
   "body": {
    "enabled": true
   }
  },
  {
   "put": "/api/v1/admin/modules/game_delivery",
   "body": {
    "enabled": true
   }
  },
  {
   "put": "/api/v1/admin/modules/server_community",
   "body": {
    "enabled": true,
    "settings": {
     "goal_amount": "200",
     "goal_currency": "${currency}",
     "goal_label": "Monthly server costs"
    }
   }
  },
  {
   "put": "/api/v1/admin/modules/gaming_storefront",
   "body": {
    "enabled": true
   }
  },
  {
   "put": "/api/v1/admin/modules/guest_checkout",
   "body": {
    "enabled": true
   },
   "optional": true
  },
  {
   "put": "/api/v1/admin/modules/timed_sales",
   "body": {
    "enabled": true
   },
   "optional": true
  },
  {
   "put": "/api/v1/admin/modules/creator_codes",
   "body": {
    "enabled": true
   },
   "optional": true
  },
  {
   "post": "/api/v1/admin/catalog/groups",
   "body": {
    "name": "VIP",
    "slug": "vip",
    "sort_order": 1
   },
   "save": "g_vip"
  },
  {
   "post": "/api/v1/admin/catalog/groups",
   "body": {
    "name": "Kits",
    "slug": "kits",
    "sort_order": 2
   },
   "save": "g_kits"
  },
  {
   "post": "/api/v1/admin/catalog/groups",
   "body": {
    "name": "Extras",
    "slug": "extras",
    "sort_order": 3
   },
   "save": "g_extra"
  },
  {
   "package": {
    "group_id": "${g_vip}",
    "slug": "vip",
    "name": "VIP",
    "sort_order": 1,
    "image_url": "/templates/rust/vip.svg",
    "description": "VIP tag, /kit vip every day, 2 extra home points and faster crafting. Renews monthly.",
    "prices": [
     {
      "currency": "${currency}",
      "cycle": "monthly",
      "amount": "4.99"
     }
    ],
    "preset": "steam",
    "commands": [
     {
      "trigger": "purchase",
      "command": "oxide.usergroup add {steamid} vip"
     },
     {
      "trigger": "expiry",
      "command": "oxide.usergroup remove {steamid} vip"
     },
     {
      "trigger": "refund",
      "command": "oxide.usergroup remove {steamid} vip"
     },
     {
      "trigger": "chargeback",
      "command": "oxide.usergroup remove {steamid} vip"
     }
    ]
   }
  },
  {
   "package": {
    "group_id": "${g_vip}",
    "slug": "vip-elite",
    "name": "Elite VIP",
    "sort_order": 2,
    "image_url": "/templates/rust/vip-elite.svg",
    "description": "Everything in VIP, plus skip the queue, /skin and a bigger backpack. Renews monthly.",
    "prices": [
     {
      "currency": "${currency}",
      "cycle": "monthly",
      "amount": "9.99"
     }
    ],
    "preset": "steam",
    "commands": [
     {
      "trigger": "purchase",
      "command": "oxide.usergroup add {steamid} elite"
     },
     {
      "trigger": "expiry",
      "command": "oxide.usergroup remove {steamid} elite"
     },
     {
      "trigger": "refund",
      "command": "oxide.usergroup remove {steamid} elite"
     },
     {
      "trigger": "chargeback",
      "command": "oxide.usergroup remove {steamid} elite"
     },
     {
      "trigger": "purchase",
      "command": "oxide.usergroup add {steamid} skipqueue"
     },
     {
      "trigger": "expiry",
      "command": "oxide.usergroup remove {steamid} skipqueue"
     }
    ]
   }
  },
  {
   "package": {
    "group_id": "${g_kits}",
    "slug": "kit-starter",
    "name": "Starter kit",
    "sort_order": 1,
    "image_url": "/templates/rust/kit-starter.svg",
    "description": "Stone tools, a bow, arrows and food to survive your first night.",
    "prices": [
     {
      "currency": "${currency}",
      "cycle": "one_time",
      "amount": "1.99"
     }
    ],
    "preset": "steam",
    "commands": [
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} stonehatchet 1",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} stone.pickaxe 1",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} bow.hunting 1",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} arrow.wooden 64",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} apple 10",
      "require_online": true
     }
    ]
   }
  },
  {
   "package": {
    "group_id": "${g_kits}",
    "slug": "kit-builder",
    "name": "Builder kit",
    "sort_order": 2,
    "image_url": "/templates/rust/kit-builder.svg",
    "description": "Wood, stone, metal fragments and a tool cupboard for your first base.",
    "prices": [
     {
      "currency": "${currency}",
      "cycle": "one_time",
      "amount": "3.99"
     }
    ],
    "preset": "steam",
    "commands": [
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} wood 5000",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} stones 5000",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} metal.fragments 1500",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} cupboard.tool 1",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} lock.code 2",
      "require_online": true
     }
    ]
   }
  },
  {
   "package": {
    "group_id": "${g_kits}",
    "slug": "kit-raider",
    "name": "Raider kit",
    "sort_order": 3,
    "image_url": "/templates/rust/kit-raider.svg",
    "description": "Satchel charges, a semi-auto rifle and medical supplies.",
    "prices": [
     {
      "currency": "${currency}",
      "cycle": "one_time",
      "amount": "6.99"
     }
    ],
    "preset": "steam",
    "commands": [
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} explosive.satchel 4",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} rifle.semiauto 1",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} ammo.rifle 128",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} syringe.medical 5",
      "require_online": true
     }
    ]
   }
  },
  {
   "package": {
    "group_id": "${g_extra}",
    "slug": "skip-queue",
    "name": "Skip the queue (30 days)",
    "sort_order": 1,
    "image_url": "/templates/rust/skip-queue.svg",
    "description": "Join the server first when it is full. Renews monthly.",
    "prices": [
     {
      "currency": "${currency}",
      "cycle": "monthly",
      "amount": "2.99"
     }
    ],
    "preset": "steam",
    "commands": [
     {
      "trigger": "purchase",
      "command": "oxide.usergroup add {steamid} skipqueue"
     },
     {
      "trigger": "expiry",
      "command": "oxide.usergroup remove {steamid} skipqueue"
     },
     {
      "trigger": "refund",
      "command": "oxide.usergroup remove {steamid} skipqueue"
     },
     {
      "trigger": "chargeback",
      "command": "oxide.usergroup remove {steamid} skipqueue"
     }
    ]
   }
  },
  {
   "package": {
    "group_id": "${g_extra}",
    "slug": "loot-crate",
    "name": "Loot crate",
    "sort_order": 2,
    "image_url": "/templates/rust/crate.svg",
    "description": "A random elite crate with weapons, armour and components.",
    "prices": [
     {
      "currency": "${currency}",
      "cycle": "one_time",
      "amount": "2.49"
     }
    ],
    "preset": "steam",
    "commands": [
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} ammo.rifle 64",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} metal.facemask 1",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} roadsigns.jacket 1",
      "require_online": true
     }
    ]
   }
  },
  {
   "package": {
    "group_id": "${g_extra}",
    "slug": "wipe-kit",
    "name": "Wipe day kit",
    "sort_order": 3,
    "image_url": "/templates/rust/wipe-kit.svg",
    "description": "Everything you need on wipe day: tools, a sleeping bag and building supplies.",
    "prices": [
     {
      "currency": "${currency}",
      "cycle": "one_time",
      "amount": "4.99"
     }
    ],
    "preset": "steam",
    "commands": [
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} hatchet 1",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} pickaxe 1",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} sleepingbag 2",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} wood 3000",
      "require_online": true
     },
     {
      "trigger": "purchase",
      "command": "inventory.giveto {steamid} stones 3000",
      "require_online": true
     }
    ]
   }
  },
  {
   "post": "/api/v1/admin/game/servers",
   "save": "server",
   "body": {
    "game": "rust",
    "name": "Main server",
    "slug": "main",
    "port": 28015,
    "transport": "none",
    "guest_checkout": true,
    "description": "Our main Rust server. Add its address and RCON password under Admin, Game servers, to deliver purchases automatically."
   }
  },
  {
   "put": "/api/v1/admin/game/servers/${server}/products",
   "body": {
    "product_ids": [
     "${p_vip}",
     "${p_vip_elite}",
     "${p_kit_starter}",
     "${p_kit_builder}",
     "${p_kit_raider}",
     "${p_skip_queue}",
     "${p_loot_crate}",
     "${p_wipe_kit}"
    ]
   }
  },
  {
   "merge": "/api/v1/admin/storefront",
   "body": {
    "theme": "rust",
    "accent": "amber",
    "layout": "grid",
    "sidebar": "right",
    "hero_title": "Support ${site_name}",
    "hero_subtitle": "VIP, kits and queue skips delivered to your Steam account in seconds. Every purchase keeps the server online.",
    "hero_image": "/templates/rust/hero.svg",
    "announcement": "Wipe every first Thursday. Grab your wipe day kit.",
    "announcement_tone": "warning",
    "widgets": [
     {
      "type": "server_status"
     },
     {
      "type": "goal"
     },
     {
      "type": "top_customer",
      "period": "month",
      "show_amount": false
     },
     {
      "type": "recent_payments",
      "limit": 5
     },
     {
      "type": "text",
      "title": "How it works",
      "body": "1. Pick a package.\n2. Sign in with Steam or enter your SteamID64.\n3. Pay, and the items arrive in game automatically."
     }
    ]
   }
  },
  {
   "post": "/api/v1/admin/site/pages",
   "optional": true,
   "body": {
    "slug": "rules",
    "title": "Server rules",
    "description": "Rules for everyone playing on the server.",
    "published": true,
    "show_in_nav": true,
    "sort_order": 10,
    "blocks": [
     {
      "type": "text",
      "props": {
       "title": "Server rules",
       "body": "1. No cheating, scripting, macros or exploiting bugs.\n2. Group limit: 4 players. No alliances above the limit.\n3. No racism, hate speech or harassment in chat or voice.\n4. No advertising other servers.\n5. Do not impersonate staff.\n6. Staff decisions are final. Appeals go through a ticket.\n\nBreaking the rules can lead to a ban without a refund of purchased perks."
      }
     }
    ]
   }
  },
  {
   "post": "/api/v1/admin/site/pages",
   "optional": true,
   "body": {
    "slug": "store-terms",
    "title": "Store terms",
    "description": "What you get when you buy from the store.",
    "published": true,
    "show_in_nav": false,
    "sort_order": 11,
    "blocks": [
     {
      "type": "text",
      "props": {
       "title": "Store terms",
       "body": "Purchases are virtual items for this Rust server and have no cash value. They are linked to the SteamID you use at checkout.\n\nVIP and queue skips renew every month until you cancel in your account. Kits and crates are delivered once, when you are online. Items are lost on wipe like any other item. If you are banned for breaking the server rules, purchases are not refunded.\n\nThis server is not affiliated with or endorsed by Facepunch Studios.\n\nQuestions? Open a support ticket and we will help."
      }
     }
    ]
   }
  },
  {
   "post": "/api/v1/admin/site/pages",
   "optional": true,
   "body": {
    "slug": "discord",
    "title": "Join our Discord",
    "description": "Chat with the community and the staff team.",
    "published": true,
    "show_in_nav": true,
    "sort_order": 12,
    "blocks": [
     {
      "type": "hero",
      "props": {
       "eyebrow": "Community",
       "title": "Join our Discord",
       "subtitle": "Wipe announcements, events, giveaways and support.",
       "primary_label": "Visit the store",
       "primary_href": "/store",
       "secondary_label": "Server rules",
       "secondary_href": "/page/rules"
      }
     },
     {
      "type": "features",
      "props": {
       "title": "What you will find",
       "columns": 3,
       "items": [
        {
         "icon": "Megaphone",
         "title": "Wipe news",
         "text": "Wipe times and map previews first."
        },
        {
         "icon": "Gift",
         "title": "Giveaways",
         "text": "Weekly giveaways for VIP and kits."
        },
        {
         "icon": "Lifebuoy",
         "title": "Support",
         "text": "Ask the staff team for help any time."
        }
       ]
      }
     }
    ]
   }
  },
  {
   "merge": "/api/v1/admin/site",
   "pointer": "/config",
   "body": {
    "site_name": "${site_name}",
    "tagline": "VIP, kits and queue skips for our Rust server.",
    "store_mode": "game",
    "public_mode": "store",
    "default_mode": "dark",
    "show_store_in_nav": true,
    "nav": [
     {
      "label": "Store",
      "href": "/store"
     },
     {
      "label": "Rules",
      "href": "/page/rules"
     },
     {
      "label": "Discord",
      "href": "/page/discord"
     },
     {
      "label": "Support",
      "href": "/tickets"
     }
    ],
    "footer_columns": [
     {
      "title": "Community",
      "links": [
       {
        "label": "Server rules",
        "href": "/page/rules"
       },
       {
        "label": "Discord",
        "href": "/page/discord"
       },
       {
        "label": "Store terms",
        "href": "/page/store-terms"
       }
      ]
     }
    ],
    "footer_text": "Not affiliated with Facepunch Studios."
   }
  }
 ]
}