{
 "id": "rust",
 "site_name": "Rust Wasteland",
 "steps": [
  {
   "put": "/api/v1/admin/modules/game_profiles",
   "body": {
    "enabled": true
   }
  },
  {
   "put": "/api/v1/admin/modules/game_delivery",
   "body": {
    "enabled": true
   }
  },
  {
   "put": "/api/v1/admin/modules/server_community",
   "body": {
    "enabled": true,
    "settings": {
     "goal_amount": "200",
     "goal_currency": "${currency}",
     "goal_label": "Monthly server costs"
    }
   }
  },
  {
   "put": "/api/v1/admin/modules/gaming_storefront",
   "body": {
    "enabled": true
   }
  },
  {
   "put": "/api/v1/admin/modules/guest_checkout",
   "body": {
    "enabled": true
   },
   "optional": true
  },
  {
   "put": "/api/v1/admin/modules/timed_sales",
   "body": {
    "enabled": true
   },
   "optional": true
  },
  {
   "put": "/api/v1/admin/modules/creator_codes",
   "body": {
    "enabled": true
   },
   "optional": true
  },
  {
   "post": "/api/v1/admin/catalog/groups",
   "body": {
    "name": "VIP",
    "slug": "vip",
    "sort_order": 1
   },
   "save": "g_vip"
  },
  {
   "post": "/api/v1/admin/catalog/groups",
   "body": {
    "name": "Kits",
    "slug": "kits",
    "sort_order": 2
   },
   "save": "g_kits"
  },
  {
   "post": "/api/v1/admin/catalog/groups",
   "body": {
    "name": "Extras",
    "slug": "extras",
    "sort_order": 3
   },
   "save": "g_extra"
  },
  {
   "package": {
    "group_id": "${g_vip}",
    "slug": "vip",
    "name": "VIP",
    "sort_order": 1,
    "image_url": "/templates/rust/vip.svg",
    "description": "Monthly VIP for the whole wipe, and the next one.\nPerks:\n- [VIP] tag in chat\n- /kit vip once per wipe\n- 2x gather rate on wood and stone\n- Skip the queue\n- 3 home teleports",
    "prices": [
     {
      "currency": "${currency}",
      "cycle": "monthly",
      "amount": "4.99"
     }
    ],
    "preset": "steam",
    "commands": [
     {
      "trigger": "purchase",
      "command": "oxide.usergroup add {steamid} vip"
     },
     {
      "trigger": "expiry",
      "command": "oxide.usergroup remove {steamid} vip"
     },
     {
      "trigger": "refund",
      "command": "oxide.usergroup remove {steamid} vip"
     },
     {
      "trigger": "chargeback",
      "command": "oxide.usergroup remove {steamid} vip"
     }
    ]
   }
  },
  {
   "package": {
    "group_id": "${g_vip}",
    "slug": "vip-elite",
