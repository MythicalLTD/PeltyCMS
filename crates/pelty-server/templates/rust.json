  {
   "post": "/api/v1/admin/game/servers",
   "save": "server",
   "body": {
    "game": "rust",
    "name": "Main server",
    "slug": "main",
    "port": 28015,
    "transport": "none",
    "guest_checkout": true,
    "description": "Our main Rust server. Add its address and RCON password under Admin, Game servers, to deliver purchases automatically."
   }
  },
  {
   "put": "/api/v1/admin/game/servers/${server}/products",
   "body": {
    "product_ids": [
     "${p_vip}",
     "${p_vip_elite}",
     "${p_vip_warlord}",
     "${p_kit_starter}",
     "${p_kit_builder}",
     "${p_kit_raider}",
     "${p_kit_medic}",
     "${p_kit_resources}",
     "${p_skip_queue}",
     "${p_loot_crate}",
     "${p_wipe_kit}",
     "${p_clan_upgrade}",
     "${p_unban}"
    ]
   }
  },
  {
   "post": "/api/v1/admin/sales",
   "optional": true,
   "body": {
    "name": "Wipe day sale",
    "percent": "20",
    "product_ids": [
     "${p_vip}",
     "${p_vip_elite}",
     "${p_vip_warlord}",
     "${p_kit_raider}",
     "${p_kit_resources}",
     "${p_kit_builder}"
    ],
    "group_ids": [],
    "starts_at": "${now}",
    "ends_at": "${in_7_days}",
    "enabled": true
   }
  },
  {
   "merge": "/api/v1/admin/storefront",
   "body": {
    "theme": "rust",
    "accent": "default",
    "layout": "grid",
    "sidebar": "right",
    "hero_title": "Support ${site_name}",
    "hero_subtitle": "VIP, kits and queue skips delivered to your Steam account in seconds. Every purchase keeps the server online.",
    "hero_image": "/templates/rust/hero.svg",
    "announcement": "Fresh wipe! 20% off VIP and the best kits until the timer runs out.",
    "announcement_tone": "warning",
    "widgets": [
     {
      "type": "server_status"
     },
     {
      "type": "goal"
     },
     {
      "type": "top_customer",
      "period": "month",
      "show_amount": false
     },
     {
      "type": "recent_payments",
      "limit": 5
     },
     {
      "type": "text",
      "title": "How it works",
      "body": "1. Pick a package.\n2. Sign in with Steam or enter your SteamID64.\n3. Pay, and the items arrive in game automatically."
     }
    ],
    "hero_badge": "Wipe day sale: 20% off VIP and kits",
    "announcement_link": "/store/vip",
    "featured_ids": [
     "${p_vip_elite}",
     "${p_vip_warlord}",
     "${p_kit_raider}",
     "${p_kit_resources}"
    ],
    "show_categories": true,
    "home_page": "store-home"
   }
  },
  {
   "post": "/api/v1/admin/site/pages",
   "optional": true,
   "body": {
    "slug": "store-home",
    "title": "Store homepage sections",
    "description": "Sections shown under the store on the homepage.",
    "published": true,
    "show_in_nav": false,
    "sort_order": 1,
    "blocks": [
     {
      "type": "comparison",
      "props": {
       "title": "Compare VIP tiers",
       "subtitle": "Every rank keeps the perks of the ranks below it.",
       "plans": "VIP, Elite, Warlord",
       "prices": "4.99 ${currency} / month, 9.99 ${currency} / month, 19.99 ${currency} / month",
       "highlight": 1,
       "badge": "Most popular",
       "links": "/store/vip, /store/vip, /store/vip",
       "cta_label": "Get it",
       "rows": [
        {
         "feature": "Chat tag",
         "values": "✓, ✓, ✓"
        },
        {
         "feature": "Kit per wipe",
         "values": "VIP, Elite, Warlord"
        },
        {
         "feature": "Gather rate",
         "values": "2x, 3x, 5x"
        },
        {
         "feature": "Faster crafting",
         "values": "—, 50%, Instant T1"
        },
        {
         "feature": "Skip the queue",
         "values": "✓, Top, Top"
        },
        {
         "feature": "Home teleports",
         "values": "3, 6, Unlimited"
        },
        {
         "feature": "/remove and /skin",
         "values": "—, /remove, Both"
        }
       ]
      }
     },
     {
      "type": "steps",
      "props": {
       "title": "How it works",
       "subtitle": "From checkout to in-game in under a minute.",
       "items": [
        {
         "icon": "Package",
         "title": "Choose a package",
         "text": "VIP, kits and extras for the current wipe."
        },
        {
         "icon": "Users",
         "title": "Link your Steam account",
         "text": "Sign in with Steam or paste your SteamID at checkout."
        },
        {
         "icon": "Lock",
         "title": "Pay securely",
         "text": "Card, PayPal and more. Your payment details never reach us."
        },
        {
         "icon": "Rocket",
         "title": "Wake up geared",
         "text": "Kits arrive in your inventory the next time you are online."
        }
       ]
      }
     },
     {
      "type": "testimonials",
      "props": {
       "title": "What players say",
       "subtitle": "Reviews from our community.",
       "items": [
        {
         "name": "RoofCamper",
         "role": "Elite VIP",
         "text": "Elite saved me hours of farming on wipe day. The resource pack is a must.",
         "rating": 5,
         "avatar": ""
        },
        {
         "name": "NakedOnBeach",
         "role": "Player",
         "text": "Fair server, admins actually answer tickets. Raider kit got delivered while I was in my base.",
         "rating": 5,
         "avatar": ""
        },
        {
         "name": "BaseBuilderBen",
         "role": "Warlord",
         "text": "Instant crafting is a game changer. Cancelling was easy when I took a break.",
         "rating": 4,
         "avatar": ""
        }
       ]
      }
     },
     {
      "type": "countdown",
      "props": {
       "title": "Wipe day sale ends soon",
       "text": "20% off VIP and the best kits. Grab them before the next wipe.",
       "ends_at": "${in_7_days}",
       "label": "Shop the sale",
       "href": "/store"
      }
     },
     {
      "type": "faq",
      "props": {
       "title": "Frequently asked questions",
       "items": [
        {
         "q": "When are kits delivered?",
         "a": "When you are online on the server. If you are offline, they are given the next time you join."
        },
        {
         "q": "Do VIP perks reset on wipe?",
         "a": "No. VIP stays for as long as your subscription runs. Kits can be claimed again every wipe."
        },
        {
         "q": "Can I gift a kit?",
         "a": "Yes. Choose \"Buy as a gift\" on any package and enter your friend's SteamID."
        },
        {
         "q": "Is this pay-to-win?",
         "a": "Kits save time but everything in them can be found by playing. Group limits apply to everyone."
        },
        {
         "q": "When is the next wipe?",
         "a": "Every Thursday at 20:00 for the map. Blueprints wipe on the first Thursday of the month."
        }
       ]
      }
     },
     {
      "type": "cta",
      "props": {
       "title": "Survive the next wipe",
