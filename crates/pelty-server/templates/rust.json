     {
      "trigger": "refund",
      "command": "oxide.usergroup remove {steamid} elite"
     },
     {
      "trigger": "chargeback",
      "command": "oxide.usergroup remove {steamid} elite"
     },
     {
      "trigger": "purchase",
      "command": "oxide.usergroup add {steamid} skipqueue"
     },
     {
      "trigger": "expiry",
      "command": "oxide.usergroup remove {steamid} skipqueue"
     }
