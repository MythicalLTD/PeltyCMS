# PeltyCMS configuration, generated by pelty-server on first start.
# Edit the values below, then start pelty-server again. Variables already set
# in the process environment (Docker, systemd, CI) take precedence over this file.
# This file holds secrets: keep it private and never commit it.

# While this says "pending", starting pelty-server in a terminal runs the
# interactive setup wizard first (`pelty-server setup` reruns it any time).
PELTY_SETUP=pending

# --- Database (required) ---------------------------------------------------
# PostgreSQL 16+ connection URL. The database must exist; tables are created
# by the migrations on every start.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/peltycms
# PELTY_DB_MAX_CONNECTIONS=10

# --- HTTP ------------------------------------------------------------------
# Listen address. Use 0.0.0.0:8080 to accept connections from other machines.
PELTY_BIND=127.0.0.1:8080
# Absolute base URL used in email links, e.g. https://billing.example.com
PELTY_PUBLIC_URL=http://localhost:8080
# Set to true once PeltyCMS is served over HTTPS (Secure cookies).
PELTY_COOKIE_SECURE=false
# Reverse proxies whose X-Forwarded-For / X-Real-IP / X-Forwarded-Proto are trusted
# (IPs or CIDRs, comma separated), e.g. 127.0.0.1,::1 for nginx/Caddy on this host.
# PELTY_TRUSTED_PROXIES=127.0.0.1,::1
# Upload caps in MB (defaults shown; attachments max 50, addon packages max 64).
# A reverse proxy has its own limit too (nginx: client_max_body_size).
# PELTY_UPLOAD_ATTACHMENT_MB=50
# PELTY_UPLOAD_AVATAR_MB=2
# PELTY_UPLOAD_KYC_MB=20
# PELTY_UPLOAD_DOWNLOAD_MB=25
# PELTY_UPLOAD_IMPORT_MB=5
# PELTY_UPLOAD_ADDON_MB=64
# Background jobs. PELTY_SCHEDULER=false: run `pelty-server cron run` every minute
# from system cron instead (per-task run hours: Admin > Automation).
# PELTY_SCHEDULER=true
# PELTY_SCHEDULER_INTERVAL_SECS=60
# PELTY_WORKER_CONCURRENCY=10
# Optional Redis (any version) for several instances: shared rate limits, one
# scheduler leader, and admin changes reloaded on every instance (console
# `cluster` lists them). Unset: single instance, in-memory limits.
# PELTY_REDIS_URL=redis://127.0.0.1:6379/0
# PELTY_SESSION_IDLE_MINUTES=1440
# PELTY_SESSION_ABSOLUTE_HOURS=720
# PELTY_AUTH_RATE_PER_MINUTE=10

# --- Secrets ---------------------------------------------------------------
# Encrypts secrets at rest (2FA seeds, server API keys, gateway secrets).
# Generated randomly on first start. Keep it stable and back it up: changing
# or losing it locks out 2FA users and makes stored secrets unreadable.
PELTY_ENCRYPTION_KEY={{ENCRYPTION_KEY}}

# --- Email -----------------------------------------------------------------
# Unset PELTY_SMTP_URL = mail is only logged, not sent.
# PELTY_SMTP_URL=smtps://user:pass@smtp.example.com:465
PELTY_MAIL_FROM=PeltyCMS <no-reply@localhost>

# --- Logging ---------------------------------------------------------------
RUST_LOG=info,sqlx=warn
# PELTY_LOG_JSON=false

# --- Folders (relative to the folder pelty-server is started in) ----------
# PELTY_FRONTEND_DIR=frontend/dist
# PELTY_THEMES_DIR=extensions/themes
# PELTY_PLUGINS_DIR=extensions/plugins
# PELTY_LOCALES_DIR=locales
# PELTY_DEFAULT_LOCALE=en
# PELTY_ADDONS_DIR=data/addons
# PELTY_ADDON_DATA_DIR=data/addons
# PELTY_ADDONS_DIST=extensions/addons/dist
# PELTY_BACKUP_DIR=backups
# PELTY_DOCS_DIR=target/docs

# --- EULA ------------------------------------------------------------------
# Instead of editing eula.txt you can accept the EULA with PELTY_EULA=true
# (meant for Docker / CI).
